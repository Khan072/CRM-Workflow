# ─────────────────────────────────────────────────────────────────────────────
#  CRM Lead Workflow — Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB connection string
# Local: mongodb://127.0.0.1:27017/crm_leads
# Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/crm_leads
MONGODB_URI=mongodb://127.0.0.1:27017/crm_leads

# Google Gemini API Key
# Get yours at: https://aistudio.google.com/app/apikey
# Leave empty to use Mock AI mode (no real AI responses)
GEMINI_API_KEY=

# Server port (default: 5000)
PORT=5000
